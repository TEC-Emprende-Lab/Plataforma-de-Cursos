# ============================================================
#  Variables de entorno — TEC Emprende Lab
#
#  Copiar a .env.local para dev. En Vercel: Settings → Env Vars.
# ============================================================

# ============================================================
# Modo de almacenamiento
# ============================================================
# local    → localStorage, sin Supabase
# supabase → Supabase + autenticación
VITE_STORAGE_MODE=local

# ============================================================
# Supabase
# ============================================================
# Solo necesarias cuando VITE_STORAGE_MODE=supabase

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL base de la Plataforma de Diagnóstico (sin slash final)
# Ejemplo: https://diagnostico-emprendimiento.vercel.app
VITE_DIAGNOSTICO_API_URL=https://diagnostico-emprendimiento.vercel.app

# Backend Flask (configurar en Render; no se expone mediante VITE_*)
APP_ENV=production
AUTH_MODE=required
SUPABASE_URL=https://qhmynvpgmrupqzojcvua.supabase.co
# Solo backend/Render. Nunca usar prefijo VITE_ ni enviar al navegador.
SUPABASE_SERVICE_ROLE_KEY=
CORS_ALLOWED_ORIGINS=https://plataforma-de-cursos-zeta.vercel.app
RATELIMIT_STORAGE_URI=redis://usuario:clave@host:6379/0
MAX_REQUEST_BYTES=10485760
MAX_SVG_BYTES=5242880
MAX_CSV_BYTES=1048576
MAX_BATCH_ROWS=200
MAX_CEDULAS=200

# Opcional: un proveedor IA. Nunca usar claves reales en este archivo.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
