# ============================================================
# Variables de entorno — TEC Emprende Lab
# ============================================================
# Para desarrollo local con Vite: copiar a .env.local
# Para Docker Compose local: usar .env
# ============================================================

# ========================= FRONTEND (Vite) =========================
# Modo de almacenamiento: local | supabase
VITE_STORAGE_MODE=supabase

# URL del backend Flask de certificados
VITE_CERT_API_URL=http://localhost:5050

# Supabase (Auth)
VITE_SUPABASE_URL=https://qhmynvpgmrupqzojcvua.supabase.co
VITE_SUPABASE_ANON_KEY=

# Plataforma de Diagnóstico
VITE_DIAGNOSTICO_API_URL=https://diagnostico-emprendimiento.vercel.app

# ========================= BACKEND (Flask) =========================
APP_ENV=production
AUTH_MODE=required

# Supabase (servicio)
SUPABASE_URL=https://qhmynvpgmrupqzojcvua.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# CORS: orígenes permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:80,http://localhost:5173,http://localhost:8080,http://localhost:3000

# Redis para rate limiting (obligatorio en producción)
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# Límites
MAX_REQUEST_BYTES=10485760
MAX_SVG_BYTES=5242880
MAX_CSV_BYTES=1048576
MAX_BATCH_ROWS=200
MAX_CEDULAS=200

# IA (opcionales)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Gunicorn (opcional)
PORT=5050
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120

# ========================= POSTGRESQL (Coolify/Docker) =========================
POSTGRES_DB=plataforma_cursos
POSTGRES_USER=plataforma
POSTGRES_PASSWORD=cambiar_este_password
DATABASE_URL=postgresql://plataforma:cambiar_este_password@postgres:5432/plataforma_cursos

